# CoreBank API — Environment Variables
# Copy this to .env and adjust values for your environment.

# Server
PORT=9090

# Spring profile (showcase = Kafka disabled, Redis fail-open, destructive ops gated)
SPRING_PROFILES_ACTIVE=showcase

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/corebank
SPRING_DATASOURCE_USERNAME=corebank
SPRING_DATASOURCE_PASSWORD=corebank123

# Kafka (disabled in showcase profile)
# COREBANK_KAFKA_ENABLED=false

# Redis (optional — app degrades gracefully without it)
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379

# Showcase token (change for your deployment)
# COREBANK_SHOWCASE_TOKEN=demo-secure-token-change-me
